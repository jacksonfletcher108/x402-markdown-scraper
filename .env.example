# Required: Base wallet that should receive USDC (0x..., 42 chars).
# Until this is a real address, the shop stays on Base Sepolia.
PAYMENT_WALLET_ADDRESS=0xYourEvmAddress
# Fallback name still honored if PAYMENT_WALLET_ADDRESS is unset:
# X402_PAY_TO=0xYourEvmAddress

# Optional. When set, Exact USDC on Solana mainnet is also advertised.
# SOLANA_WALLET_ADDRESS=YourSolanaBase58Address

# After X402_PAY_TO is set, both networks are offered. Coinbase Wallet uses Base mainnet.
X402_NETWORKS=eip155:8453,eip155:84532

FACILITATOR_URL=https://facilitator.payai.network
SEPOLIA_FACILITATOR_URL=https://x402.org/facilitator

# Optional. When both are set, verify/settle go through Coinbase CDP (Bazaar).
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Optional. Public Reown project id (cloud.reown.com); shows the playground's WalletConnect QR button.
# WALLETCONNECT_PROJECT_ID=
HOST=0.0.0.0
PORT=4021
